{
  "name": "resume-portfolio-template",
  "version": "1.0.0",
  "description": "Modern full-stack portfolio and resume website with admin panel. Built with Next.js 15, TypeScript, Prisma, and Tailwind CSS v4.",
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheExtravagantHobo/ehl-resume-homepage.git"
  },
  "keywords": [
    "resume",
    "portfolio",
    "nextjs",
    "typescript",
    "prisma",
    "tailwind",
    "admin-panel"
  ],
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "validate:env": "node -e \"require('./lib/env.ts')\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next node_modules",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-switch": "^1.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.0.0",
    "@vercel/speed-insights": "^1.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.2",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.552.0",
    "next": "^15.5.6",
    "next-auth": "^4.24.5",
    "next-themes": "^0.4.6",
    "prisma": "^6.18.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.5.3",
    "typescript": "^5.9.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.6",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
